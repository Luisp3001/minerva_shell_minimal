# Build rule for target.
caelestia-imagesplugin_autogen: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 caelestia-imagesplugin_autogen
.PHONY : caelestia-imagesplugin_autogen

# fast build rule for target.
caelestia-imagesplugin_autogen/fast:
	$(MAKE) $(MAKESILENT) -f src/Caelestia/Images/CMakeFiles/caelestia-imagesplugin_autogen.dir/build.make src/Caelestia/Images/CMakeFiles/caelestia-imagesplugin_autogen.dir/build
.PHONY : caelestia-imagesplugin_autogen/fast

